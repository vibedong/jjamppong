{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Shared Meaning Lock",
  "type": "object",
  "required": ["artifact_id", "artifact_version", "user_meaning", "unresolved_ambiguity", "user_confirmation"],
  "properties": {
    "artifact_id": { "const": "harness.shared_meaning_lock" },
    "artifact_version": { "const": "1.0.6" },
    "user_meaning": { "type": "string", "minLength": 1 },
    "unresolved_ambiguity": { "type": "array", "items": { "type": "string" } },
    "user_confirmation": {
      "type": "object",
      "required": ["confirmed", "exact_user_words"],
      "properties": {
        "confirmed": { "const": true },
        "exact_user_words": { "type": "string", "minLength": 2 }
      }
    }
  }
}
